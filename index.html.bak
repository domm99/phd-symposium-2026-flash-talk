<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Self-Organizing Federated Learning </title>
  <style>
    :root {
      --slide-w: 1216px;
      --slide-h: 684px;
      --ink: #1d252c;
      --muted: #5d6972;
      --paper: #f8faf8;
      --panel: #ffffff;
      --line: #d8e0dc;
      --teal: #007f8f;
      --cyan: #65bfd0;
      --green: #86aa3f;
      --amber: #f1b64c;
      --coral: #df735f;
      --blue: #4a78b8;
      --shadow: 0 18px 55px rgba(26, 39, 48, 0.16);
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      min-height: 100%;
      overflow: hidden;
      background: #263238;
      color: var(--ink);
      font-family: "Aptos", "Inter", "Helvetica Neue", Arial, sans-serif;
      letter-spacing: 0;
    }

    body {
      display: grid;
      place-items: center;
    }

    .slide-stage {
      position: relative;
      width: var(--slide-w);
      height: var(--slide-h);
    }

    .slide {
      position: relative;
      width: var(--slide-w);
      height: var(--slide-h);
      overflow: hidden;
      background:
        linear-gradient(90deg, rgba(0, 127, 143, 0.08) 0 1px, transparent 1px) 0 0 / 44px 44px,
        linear-gradient(0deg, rgba(134, 170, 63, 0.07) 0 1px, transparent 1px) 0 0 / 44px 44px,
        var(--paper);
      box-shadow: var(--shadow);
      transform-origin: top left;
    }

    .slide-inner {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: 14px;
      padding: 26px 38px 18px;
    }

    header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 190px 210px;
      gap: 22px;
      align-items: center;
      border-bottom: 3px solid var(--ink);
      padding-bottom: 14px;
    }

    .kicker {
      color: var(--teal);
      font-size: 15px;
      font-weight: 800;
      text-transform: uppercase;
    }

    h1 {
      margin: 6px 0 0;
      max-width: 1030px;
      font-size: 34px;
      line-height: 0.96;
      font-weight: 860;
      letter-spacing: 0;
      white-space: nowrap;
    }

    .subtitle {
      margin-top: 7px;
      color: var(--muted);
      font-size: 16px;
      font-weight: 600;
    }

    .identity {
      display: grid;
      justify-items: end;
      text-align: right;
    }

    .logo-wrap {
      display: grid;
      place-items: center;
      align-self: stretch;
    }

    .logo {
      width: 240px;
      height: 130px;
      object-fit: contain;
      object-position: center;
    }

    .name {
      font-size: 17px;
      font-weight: 850;
    }

    .affiliation {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.25;
      font-weight: 650;
    }

    main {
      display: grid;
      grid-template-columns: 1.23fr 0.92fr;
      gap: 18px;
      min-height: 0;
    }

    .scenario {
      position: relative;
      overflow: hidden;
      border: 2px solid var(--ink);
      border-radius: 8px;
      background: var(--panel);
      min-height: 0;
    }

    .scenario-content {
      position: relative;
      z-index: 1;
      height: 100%;
      display: grid;
      grid-template-rows: auto auto minmax(0, 1fr);
      gap: 10px;
      padding: 18px 22px;
    }

    .section-label {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      min-height: 28px;
      border: 2px solid var(--ink);
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.86);
      padding: 5px 11px;
      font-size: 14px;
      font-weight: 850;
      text-transform: uppercase;
    }

    .scenario-copy {
      align-self: start;
      max-width: 100%;
    }

    .scenario-copy h2 {
      margin: 0;
      font-size: 27px;
      line-height: 0.98;
      letter-spacing: 0;
    }

    .scenario-copy p {
      margin: 7px 0 0;
      max-width: 610px;
      color: #33424a;
      font-size: 15px;
      line-height: 1.22;
      font-weight: 650;
    }

    .noniid-card {
      position: relative;
      z-index: 3;
      display: grid;
      grid-template-rows: minmax(0, 1fr);
      align-items: center;
      width: 100%;
      min-height: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      padding: 0;
      box-shadow: none;
    }

    .figure-frame {
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 0;
      overflow: hidden;
      border-radius: 0;
      border: 0;
      background: white;
      display: grid;
      place-items: center;
    }

    .noniid-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
    }

    .side {
      display: grid;
      grid-template-rows: 0.88fr 1.12fr;
      gap: 14px;
      min-height: 0;
    }

    .panel {
      border: 2px solid var(--ink);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.92);
      padding: 14px 18px;
      min-height: 0;
      display: grid;
      grid-template-rows: auto 1fr;
      gap: 9px;
    }

    .panel-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border-bottom: 2px solid var(--ink);
      padding-bottom: 7px;
    }

    .panel-title h2 {
      margin: 0;
      font-size: 22px;
      line-height: 1;
      text-transform: uppercase;
    }

    .tag {
      flex: 0 0 auto;
      border-radius: 999px;
      padding: 4px 9px;
      color: white;
      background: var(--teal);
      font-size: 11px;
      font-weight: 850;
      text-transform: uppercase;
    }

    .challenge-list {
      display: grid;
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
      align-content: center;
    }

    .challenge-list li {
      display: grid;
      grid-template-columns: 30px 1fr;
      gap: 9px;
      align-items: start;
      color: #2c3940;
      font-size: 14px;
      line-height: 1.18;
      font-weight: 700;
    }

    .number {
      display: inline-grid;
      place-items: center;
      width: 28px;
      height: 28px;
      border: 2px solid var(--ink);
      border-radius: 50%;
      color: white;
      background: var(--coral);
      font-size: 13px;
      font-weight: 900;
    }

    .challenge-list li:nth-child(2) .number {
      background: var(--blue);
    }

    .challenge-list li:nth-child(3) .number {
      background: var(--amber);
      
    }

    .research {
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      padding-bottom: 12px;
    }

    .thesis {
      margin: 0;
      color: #26343b;
      font-size: 14px;
      line-height: 1.14;
      font-weight: 760;
    }

    .flow {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 8px;
      align-self: center;
    }

    .step {
      position: relative;
      min-height: 74px;
      border: 2px solid var(--ink);
      border-radius: 8px;
      padding: 9px 9px 8px;
      background: #fdfefd;
      display: grid;
      grid-template-rows: 35px 25px auto;
      align-content: start;
      gap: 5px;
    }

    .step:not(:last-child)::after {
      content: ">";
      position: absolute;
      right: -13px;
      top: 50%;
      transform: translateY(-50%);
      width: 17px;
      height: 22px;
      color: var(--ink);
      background: var(--paper);
      font-size: 22px;
      line-height: 19px;
      font-weight: 950;
      text-align: center;
      z-index: 1;
    }

    .step b {
      display: block;
      font-size: 12px;
      line-height: 1;
      text-transform: uppercase;
    }

    .step > span {
      color: var(--muted);
      font-size: 9px;
      line-height: 1.12;
      font-weight: 700;
    }

    .dot-row {
      display: flex;
      gap: 5px;
      align-items: start;
      height: 35px;
    }

    .mini-dot {
      width: 15px;
      height: 15px;
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: var(--cyan);
    }

    .mini-dot:nth-child(2),
    .mini-dot:nth-child(5) {
      background: var(--green);
    }

    .mini-dot:nth-child(3),
    .mini-dot:nth-child(6) {
      background: var(--amber);
    }

    .cluster-icon {
      display: grid;
      grid-template-columns: repeat(3, 15px);
      grid-auto-rows: 15px;
      gap: 3px;
      height: 35px;
      align-content: start;
    }

    .cluster-icon i {
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: var(--green);
    }

    .cluster-icon i:nth-child(3n) {
      background: var(--coral);
    }

    .model-bars {
      display: grid;
      gap: 4px;
      align-content: start;
      width: 72px;
      height: 35px;
    }

    .bar {
      height: 9px;
      border: 2px solid var(--ink);
      border-radius: 999px;
      background: var(--blue);
    }

    .bar:nth-child(2) {
      width: 55px;
      background: var(--amber);
    }

    .bar:nth-child(3) {
      width: 40px;
      background: var(--green);
    }

    .methods {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      align-self: end;
      padding-top: 1px;
      max-width: 100%;
    }

    .method {
      border: 2px solid var(--ink);
      border-radius: 6px;
      padding: 3px 6px;
      background: white;
      font-size: 10px;
      font-weight: 900;
      text-transform: uppercase;
    }

    footer {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 18px;
      align-items: end;
      color: #536069;
      font-size: 9px;
      line-height: 1.2;
      font-weight: 650;
    }

    .refs {
      display: flex;
      flex-wrap: wrap;
      gap: 11px;
    }

    .refs span {
      white-space: nowrap;
    }

    .event {
      color: var(--ink);
      font-weight: 850;
      text-transform: uppercase;
      white-space: nowrap;
    }

    @media print {
      @page {
        size: 16in 9in;
        margin: 0;
      }

      html,
      body {
        width: 16in;
        height: 9in;
        padding: 0;
        background: white;
      }

      .slide-stage {
        width: 16in;
        height: 9in;
      }

      .slide {
        transform: scale(1.2631578947) !important;
        box-shadow: none;
      }
    }
  </style>
</head>
<body>
  <div class="slide-stage">
  <section class="slide" aria-label="Single slide for CSE PhD Symposium 2026">
    <div class="slide-inner">
      <header>
        <div>
          <div class="kicker">CSE PhD Symposium 2026 | Flash talk</div>
          <h1>Self-Organizing Federated Learning </h1>
          <div class="subtitle">From one fragile global model to local, adaptive self-federations</div>
        </div>
        <div class="logo-wrap">
          <img class="logo" src="images/university.svg" alt="University of Bologna logo">
        </div>
        <div class="identity">
          <div>
            <div class="name">Davide Domini</div>
            <div class="affiliation">3rd year PhD student<br>davide.domini@unibo.it</div>
          </div>
        </div>
      </header>

      <main>
        <section class="scenario" aria-label="Reference scenario">
          <div class="scenario-content">
            <div class="section-label">Reference scenario</div>

            <div class="scenario-copy">
              <h2>Learning at the edge, where context matters</h2>
              <p>Nearby devices observe related phenomena, but the whole system remains spatially heterogeneous.</p>
            </div>

            <div class="noniid-card">
              <div class="figure-frame">
                <img src="images/noniid.jpg" alt="Spatial non-IID network illustration">
              </div>
            </div>
          </div>
        </section>

        <aside class="side">
          <section class="panel challenges" aria-label="Research challenges">
            <div class="panel-title">
              <h2>Challenges</h2>
              <span class="tag">why hard</span>
            </div>
            <ul class="challenge-list">
              <li><span class="number">1</span><span>Non-IID data breaks the assumption behind one shared global model.</span></li>
              <li><span class="number">2</span><span>Central aggregation becomes a bottleneck and a single point of failure.</span></li>
              <li><span class="number">3</span><span>Edge devices are resource-constrained, mobile, and intermittently available.</span></li>
            </ul>
          </section>

          <section class="panel research" aria-label="Research direction">
            <div class="panel-title">
              <h2>Research direction</h2>
              <span class="tag">my PhD</span>
            </div>
            <p class="thesis">Use field-based coordination to let devices discover who to learn with, then train specialized and lightweight models.</p>

            <div class="flow">
              <div class="step">
                <div class="dot-row">
                  <span class="mini-dot"></span>
                  <span class="mini-dot"></span>
                  <span class="mini-dot"></span>
                  <span class="mini-dot"></span>
                  <span class="mini-dot"></span>
                  <span class="mini-dot"></span>
                </div>
                <b>Spatial context</b>
                <span>Local observations plus neighbor interactions.</span>
              </div>
              <div class="step">
                <div class="cluster-icon">
                  <i></i><i></i><i></i><i></i><i></i><i></i>
                </div>
                <b>Self-federations</b>
                <span>Emergent leaders and adaptive regions.</span>
              </div>
              <div class="step">
                <div class="model-bars">
                  <span class="bar"></span>
                  <span class="bar"></span>
                  <span class="bar"></span>
                </div>
                <b>Specialized models</b>
                <span>Sparse, personalized training at the edge.</span>
              </div>
            </div>

            <div class="methods">
              <span class="method">FBFL</span>
              <span class="method">PSFL</span>
              <span class="method">SParSeFuL</span>
              <span class="method">Aggregate computing</span>
            </div>
          </section>
        </aside>
      </main>

      <footer>
        <div class="refs">
          <span>FBFL: DOI 10.46298/LMCS-22(1:19)2026</span>
          <span>PSFL: DOI 10.1016/j.iot.2025.101841</span>
          <span>SParSeFuL: SSRN 6584516</span>
        </div>
        <div class="event">Friday, June 12 | 3 min</div>
      </footer>
    </div>
  </section>
  </div>
  <script>
    const baseWidth = 1216;
    const baseHeight = 684;
    const margin = 36;

    function fitSlide() {
      const stage = document.querySelector(".slide-stage");
      const slide = document.querySelector(".slide");
      const availableWidth = Math.max(320, window.innerWidth - margin);
      const availableHeight = Math.max(180, window.innerHeight - margin);
      const scale = Math.min(availableWidth / baseWidth, availableHeight / baseHeight, 1);

      stage.style.width = `${baseWidth * scale}px`;
      stage.style.height = `${baseHeight * scale}px`;
      slide.style.transform = `scale(${scale})`;
    }

    window.addEventListener("resize", fitSlide);
    window.addEventListener("load", fitSlide);
    fitSlide();
  </script>
</body>
</html>
